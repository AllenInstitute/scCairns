python -u ./inspect_integration.py \
  --config ./pipeline_scvi.yml \
  --input /root/capsule/results/rounds/round_04/integrated.h5ad \
  --output-dir /root/capsule/results/rounds/round_04_sweep \
  --all-sweep-architectures