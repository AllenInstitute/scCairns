# upload the decisions, filter, then pass the filtered object to integrate and inspect
python -u ./inspect_integration.py \
  --config ./pipeline_scvi.yml \
  --input /root/capsule/data/260605_cmg_round3/integrated.h5ad \
  --decisions /root/capsule/data/260605_cmg_round3/inspect_small_gene_nb/decisions_round3.yaml \
  --output-dir /root/capsule/results/rounds/round_04

python -u ./integrate_sns_scvi.py \
  --config ./pipeline_scvi.yml \
  --input /root/capsule/results/rounds/round_04/filtered.h5ad \
  --output-dir /root/capsule/results/rounds/round_04

